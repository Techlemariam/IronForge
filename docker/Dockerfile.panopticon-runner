FROM myoung34/github-runner:latest

# Sätt miljövariabel för att undvika interaktiva installationsfrågor
ENV DEBIAN_FRONTEND=noninteractive

# 1. Installera grundläggande verktyg, kompilatorer och systemberoenden för Tauri/Taktpinne
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    jq \
    git \
    docker.io \
    build-essential \
    libssl-dev \
    pkg-config \
    # Beroenden för Tauri/Taktpinne
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    patchelf \
    # Webbläsarkompatibilitet (Cypress/Playwright-grundbibliotek)
    xvfb \
    libgbm-dev \
    libnss3 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# 2. Installera Rust toolchain centralt (för Tauri/Rust-byggen)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# 3. Installera Doppler CLI för säker secrets-injektion
RUN (curl -Ls https://cli.doppler.com/install.sh || wget -qO- https://cli.doppler.com/install.sh) | sh

# 4. Globala Node-verktyg och pakethanterare (inklusive snyk för säkerhet)
RUN npm install -g pnpm@10.4.1 snyk

# 5. Installera alla systemnivå-beroenden för Playwright
RUN npx playwright install-deps

# Ställ in arbetskatalog för körningar
WORKDIR /tmp/github-runner
